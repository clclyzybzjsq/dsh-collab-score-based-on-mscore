{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "rootDir": "src",
    "outDir": "lib"
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
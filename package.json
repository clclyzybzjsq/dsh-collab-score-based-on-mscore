{
  "name": "@local/dsh-collab-score",
  "version": "0.1.0",
  "description": "DSH 乐谱协作插件：会话内可开关的乐谱编辑/预览/播放面板 + agent 乐谱工具（score-collab 乐谱模式预设）。MuseScore 文件格式兼容，不依赖桌面端。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "default": "./lib/server.js"
    },
    "./score-tools": {
      "types": "./lib/score-tools.d.ts",
      "default": "./lib/score-tools.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.client.json && tsdown",
    "test:bridge": "node --test test/bridge.test.mjs",
    "test:server": "node scripts/test-server.mjs"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "preset",
    "LICENSE",
    "README.md"
  ],
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "link:D:/deepseek-harness/packages/core/tools"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}